# Pose-Booth AI API Environment Configuration
# Copy this file to .env and adjust values for the target machine.

# Profile: 'edge' (Laptop RTX 4050 / FP16) or 'studio' (Workstation RTX 3060 12GB+)
AI_PROFILE=studio

# Device: 'cuda:0' or 'cpu' (auto-detected)
DEVICE=cuda:0

# FP16 Half Precision for 2x faster inference on RTX GPUs
USE_FP16=true

# AI Model
MODEL_PATH=models/yolov8x-pose.pt
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.65

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
