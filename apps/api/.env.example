# Pose-Booth AI API Environment Configuration
# Target Hardware: Intel Core i5-13500HX + NVIDIA GeForce RTX 4050 6GB Laptop GPU + 24GB DDR5 RAM

# Profile: 'edge' (Laptop RTX 4050 / FP16) or 'studio' (Workstation RTX 3060 12GB+)
AI_PROFILE=edge

# Device: 'cuda:0' or 'cpu' (auto-detected)
DEVICE=cuda:0

# FP16 Half Precision for 2x faster inference on RTX GPUs
USE_FP16=true

# AI Model
MODEL_PATH=yolov8s-pose.pt
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.65

# Server
HOST=127.0.0.1
PORT=8000
